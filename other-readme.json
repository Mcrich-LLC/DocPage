{"sections":[],"variants":[{"paths":["\/documentation\/template\/documentation"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Template\/documentation\/Template"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Template\/documentation\/Template\/Documentation"},"abstract":[{"type":"text","text":"DocCKit is a SwiftUI package for loading, parsing, and rendering DocC-style JSON."}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"DocCKit is the backbone of ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Mcrich-LLC\/DocB"},{"text":". DocB uses it for the heavy lifting around DocC loading, parsing, navigation handoff, and SwiftUI rendering, while the app keeps the things that make it an app, like bookmarks, persistence, settings, and window behavior.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to see a full app built on top of DocCKit, DocB is the best example. If you want the package by itself, you can use it for full DocC archives, Apple Developer Documentation, or just a single JSON file that happens to use the DocC article structure."}]},{"type":"heading","level":2,"anchor":"Requirements","text":"Requirements"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Xcode 26 or newer","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift 6.2 or newer"}]}]}]},{"type":"heading","level":3,"anchor":"Minimum-Targets","text":"Minimum Targets:"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"iOS 18"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"macOS 15"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"visionOS 2","type":"text"}]}]}]},{"type":"heading","level":2,"anchor":"Installing-The-Package","text":"Installing The Package"},{"type":"heading","level":3,"anchor":"Xcode","text":"Xcode"},{"type":"paragraph","inlineContent":[{"text":"Go to ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"File"}]},{"type":"text","text":" > "},{"type":"strong","inlineContent":[{"type":"text","text":"Add Package Dependencies…"}]},{"type":"text","text":" and paste in:"}]},{"code":["https:\/\/github.com\/Mcrich-LLC\/DocCKit.git"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"Then add the ","type":"text"},{"type":"codeVoice","code":"DocCKit"},{"text":" product to your app target.","type":"text"}],"type":"paragraph"},{"anchor":"Swift-Package-Manager","level":3,"type":"heading","text":"Swift Package Manager"},{"inlineContent":[{"type":"text","text":"Add this to the "},{"type":"codeVoice","code":"dependencies"},{"type":"text","text":" section of your "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["dependencies: [","    .package(url: \"https:\/\/github.com\/Mcrich-LLC\/DocCKit.git\", branch: \"main\")","]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Then add ","type":"text"},{"type":"codeVoice","code":"DocCKit"},{"text":" to your target:","type":"text"}],"type":"paragraph"},{"code":["targets: [","    .target(","        name: \"YourTarget\",","        dependencies: [","            \"DocCKit\"","        ]","    )","]"],"type":"codeListing","syntax":"swift"},{"anchor":"Basic-Setup","level":2,"type":"heading","text":"Basic Setup"},{"inlineContent":[{"text":"DocCKit renderers need a navigator. This is where you keep your selected article, selected framework, split-view state, and deep link scheme.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Here is a small example:","type":"text"}],"type":"paragraph"},{"code":["import SwiftUI","import DocCKit","","@Observable","@MainActor","final class DocumentationNavigator: DocCNavigator {","    var reference: Reference?","    var technology: AppleTechnologies.FrameworkSection?","    var isUsingSplitView = false","","    \/\/ By default this tries to read the app's Info.plist URL schemes.","    \/\/ You can also make it explicit:","    var deepLinkScheme = DocCDeepLinkScheme(\"my-app-docs\")","","    func setReference(_ reference: Reference?, forceHistory: Bool) {","        self.reference = reference","    }","","    func setTechnology(_ technology: AppleTechnologies.FrameworkSection?, noHistory: Bool) {","        self.technology = technology","    }","","    func showHomepage() {","        reference = nil","        technology = nil","    }","}"],"type":"codeListing","syntax":"swift"},{"content":[{"inlineContent":[{"type":"text","text":""},{"code":"DocCNavigator","type":"codeVoice"},{"text":" does not include bookmarks, window management, SwiftData, onboarding, or any of DocB’s app-specific history internals. That part belongs in your app, either in this class or a different one.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"anchor":"Deep-Links","level":2,"type":"heading","text":"Deep Links"},{"type":"paragraph","inlineContent":[{"type":"text","text":"DocCKit creates local documentation links from DocC identifiers such as:"}]},{"type":"codeListing","code":["doc:\/\/example\/documentation\/MyKit\/MyType"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"For those links to loop back into your app, your app should register a URL scheme in its Info.plist."}]},{"type":"paragraph","inlineContent":[{"text":"DocCKit will try to find a scheme in this order:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"code":"DocCKitDeepLinkScheme","type":"codeVoice"},{"text":" in your Info.plist.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DocCDeepLinkScheme"},{"type":"text","text":" in your Info.plist."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"CFBundleURLTypes"},{"type":"text","text":" entry matching your bundle identifier."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The first registered URL scheme that is not "},{"code":"doc","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"doc:\/\/","type":"codeVoice"},{"text":" as a fallback.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"You can also configure it manually in your navigator:","type":"text"}]},{"type":"codeListing","code":["var deepLinkScheme = DocCDeepLinkScheme(\"my-app-docs\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If your app’s URL scheme is ","type":"text"},{"code":"my-app-docs","type":"codeVoice"},{"text":", DocCKit will turn:","type":"text"}]},{"code":["doc:\/\/example\/documentation\/MyKit\/MyType"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"into:","type":"text"}]},{"code":["my-app-docs:\/\/example\/documentation\/MyKit\/MyType"],"type":"codeListing","syntax":null},{"level":2,"type":"heading","text":"Rendering Apple Developer Documentation","anchor":"Rendering-Apple-Developer-Documentation"},{"type":"paragraph","inlineContent":[{"text":"If you want to render Apple docs, use ","type":"text"},{"code":"AppleDocsClient","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["import SwiftUI","import DocCKit","","struct AppleArticleExample: View {","    @State private var article: Article?","    @State private var navigator = DocumentationNavigator()","","    let identifier = \"doc:\/\/com.apple.documentation\/documentation\/swift\/string\"","","    var body: some View {","        Group {","            if let article {","                DocCArticleView(article: article, navigator: navigator, identifier: identifier)","            } else {","                ProgressView(\"Loading\")","            }","        }","        .task {","            do {","                article = try await AppleDocsClient().fetchArticle(for: identifier)","            } catch {","                print(error)","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want Objective-C variants where Apple provides them:"}]},{"code":["let client = AppleDocsClient(preferredLanguage: .objectivec)","let article = try await client.fetchArticle(for: identifier)"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Rendering A Custom DocC Archive","anchor":"Rendering-A-Custom-DocC-Archive"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a normal DocC archive or static DocC website, use "},{"type":"codeVoice","code":"DocCClient"},{"type":"text","text":"."}]},{"code":["let baseURL = URL(string: \"https:\/\/example.com\/MyDocs\")!","let client = try await DocCClient(baseURL: baseURL)","let page = try await client.fetchArticlePage(","    for: \"doc:\/\/example\/documentation\/MyKit\/MyType\"",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Then render it:","type":"text"}]},{"code":["DocCArticleView(page: page, navigator: navigator)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DocCClient"},{"type":"text","text":" keeps the resolved "},{"type":"codeVoice","code":"DocCSource"},{"type":"text","text":" on "},{"type":"codeVoice","code":"client.source"},{"type":"text","text":", so if your app wants to persist the index or build custom navigation around it, you can still grab the source directly:"}]},{"code":["let source = client.source","let frameworkSections = source.allFrameworkSections"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you already have a stored "},{"type":"codeVoice","code":"DocCSource"},{"text":", rebuild the client from that:","type":"text"}]},{"code":["let client = DocCClient(source: storedSource)","let article = try await client.fetchArticle(","    for: \"doc:\/\/example\/documentation\/MyKit\/MyType\"",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The low-level helpers are still available without creating a client:"}]},{"type":"codeListing","syntax":"swift","code":["let index = try await DocCClient.fetchIndex(baseURL: baseURL)","let jsonURL = DocCClient.jsonURL(","    for: \"doc:\/\/example\/documentation\/MyKit\/MyType\",","    source: source",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can still pass a full "},{"type":"codeVoice","code":"Reference"},{"type":"text","text":" if your app already has one from a DocC index or wants to preserve extra reference metadata:"}]},{"type":"codeListing","syntax":"swift","code":["DocCArticleView(article: article, reference: reference, navigator: navigator)"]},{"level":2,"type":"heading","text":"Showing Symbol Badges","anchor":"Showing-Symbol-Badges"},{"type":"paragraph","inlineContent":[{"type":"text","text":"DocCKit can render Xcode-style symbol badges for DocC references. The reference list rows can show class, struct, protocol, enum, method, property, article, and custom image badges."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To show badges in an article’s related links and other reference lists, enable "},{"type":"codeVoice","code":"showsReferenceSymbolBadges"},{"type":"text","text":" like so:"}]},{"type":"codeListing","syntax":"swift","code":["DocCArticleView(","    page: page,","    navigator: navigator,","    showsReferenceSymbolBadges: true",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also render a badge directly:"}]},{"type":"codeListing","syntax":"swift","code":["DocCSymbolBadge(","    symbolKind: SidebarSearchSymbolKind(reference: reference, title: reference.title ?? \"\"),","    size: 22,","    customImageIdentifier: reference.images?.first(where: { $0.type == .icon })?.identifier,","    references: article.references,","    docCSite: client.source",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For custom index icons, use the icon identifier from "},{"type":"codeVoice","code":"DocCIndex.InterfaceLanguage\/icon"},{"type":"text","text":" and the archive identifier from "},{"type":"codeVoice","code":"DocCIndex\/includedArchiveIdentifiers"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["DocCSymbolBadge(","    symbolKind: SidebarSearchSymbolKind(interfaceLanguage: interfaceLanguage),","    size: 22,","    customImageIdentifier: interfaceLanguage.icon,","    docCSite: client.source,","    archiveIdentifier: client.source.index.includedArchiveIdentifiers?.first",")"]},{"type":"paragraph","inlineContent":[{"text":"If the custom image cannot be resolved or loaded, ","type":"text"},{"code":"DocCSymbolBadge","type":"codeVoice"},{"text":" falls back to the standard badge for the resolved symbol kind.","type":"text"}]},{"level":2,"type":"heading","text":"Pulling One File","anchor":"Pulling-One-File"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You do not need a full DocC archive to use DocCKit."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you just want a nice rich article view in your app, you can host or bundle a single JSON file that matches DocC’s "},{"type":"codeVoice","code":"Article"},{"type":"text","text":" shape. This is useful for things like:"}]},{"items":[{"content":[{"inlineContent":[{"text":"Release notes","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Help pages"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"“What’s New” screens"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"App guides"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Terms written as structured content","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Any non-documentation content where DocC’s article layout happens to be useful","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Remote JSON","anchor":"Remote-JSON","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["struct RemoteArticleView: View {","    @State private var article: Article?","    @State private var navigator = DocumentationNavigator()","","    let articleURL = URL(string: \"https:\/\/example.com\/app-guide.json\")!","","    var body: some View {","        Group {","            if let article {","                DocCArticleView(","                    article: article,","                    navigator: navigator,","                    identifier: \"doc:\/\/my-app\/app-guide\"","                )","            } else {","                ProgressView(\"Loading\")","            }","        }","        .task {","            do {","                let (data, _) = try await URLSession.shared.data(from: articleURL)","                article = try JSONDecoder().decode(Article.self, from: data)","            } catch {","                print(error)","            }","        }","    }","}"]},{"text":"Bundled JSON","anchor":"Bundled-JSON","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"app-guide.json"},{"type":"text","text":" to your app target, then decode it:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func bundledArticle(named name: String) throws -> Article {","    guard let url = Bundle.main.url(forResource: name, withExtension: \"json\") else {","        throw URLError(.fileDoesNotExist)","    }","","    let data = try Data(contentsOf: url)","    return try JSONDecoder().decode(Article.self, from: data)","}"]},{"inlineContent":[{"type":"text","text":"Then render it the same way:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let article = try bundledArticle(named: \"app-guide\")","","DocCArticleView(","    article: article,","    navigator: navigator,","    identifier: \"doc:\/\/my-app\/app-guide\"",")"]},{"text":"A Small Article JSON Example","anchor":"A-Small-Article-JSON-Example","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"This is intentionally small. Real DocC JSON can be much larger, but this is enough to render a simple page."}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","    \"metadata\": {","        \"role\": \"article\",","        \"roleHeading\": \"Guide\",","        \"title\": \"Using My App\"","    },","    \"references\": {},","    \"primaryContentSections\": [","        {","            \"kind\": \"content\",","            \"content\": [","                {","                    \"type\": \"heading\",","                    \"level\": 2,","                    \"text\": \"Getting Started\"","                },","                {","                    \"type\": \"paragraph\",","                    \"inlineContent\": [","                        {","                            \"type\": \"text\",","                            \"text\": \"This screen is powered by DocCKit, but the content does not have to be about documentation.\"","                        }","                    ]","                }","            ]","        }","    ]","}"]},{"text":"Rendering A Homepage","anchor":"Rendering-A-Homepage","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you would like Apple’s Documentation homepage payload:"}]},{"type":"codeListing","syntax":"swift","code":["let homepage = try await AppleDocsClient().fetchHomepage()","","DocCHomepageView(homepage: homepage, navigator: navigator)"]},{"type":"paragraph","inlineContent":[{"text":"For a manually hosted homepage JSON file:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let (data, _) = try await URLSession.shared.data(from: homepageURL)","let homepage = try JSONDecoder().decode(HomepageParser.self, from: data)"]},{"type":"heading","level":2,"text":"Rendering A Framework Page","anchor":"Rendering-A-Framework-Page"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Framework pages need both a decoded "},{"code":"Framework","type":"codeVoice"},{"type":"text","text":" and the "},{"code":"AppleTechnologies.FrameworkSection","type":"codeVoice"},{"type":"text","text":" that represents it in navigation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a custom DocC source, the page API builds that context for you:"}]},{"type":"codeListing","syntax":"swift","code":["let client = try await DocCClient(baseURL: baseURL)","let page = try await client.fetchFrameworkPage(","    for: \"doc:\/\/example\/documentation\/MyKit\"",")","","DocCFrameworkView(page: page, navigator: navigator)"]},{"type":"paragraph","inlineContent":[{"text":"For Apple docs, fetch the framework and pass the section your app selected from the technologies payload:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let framework = try await AppleDocsClient().fetchFramework(","    for: \"doc:\/\/com.apple.documentation\/documentation\/swiftui\"",")","","DocCFrameworkView(","    framework: framework,","    frameworkSection: frameworkSection,","    navigator: navigator",")"]},{"type":"paragraph","inlineContent":[{"text":"If you are rendering a single article or app guide, you probably do not need framework pages.","type":"text"}]},{"type":"heading","level":2,"text":"Using DocCClientBridge","anchor":"Using-DocCClientBridge"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app can open both Apple docs and custom DocC sources, "},{"type":"codeVoice","code":"DocCClientBridge"},{"type":"text","text":" lets you avoid branching all over your code."}]},{"type":"codeListing","syntax":"swift","code":["let client: DocCClientBridge","","if let source {","    client = .docC(source)","} else {","    client = .apple(preferredLanguage: .swift)","}","","let article = try await client.fetchArticle(for: reference.identifier)"]},{"type":"heading","level":2,"text":"What DocCKit Does Not Do","anchor":"What-DocCKit-Does-Not-Do"},{"type":"paragraph","inlineContent":[{"text":"DocCKit is not trying to be a full app.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It does not provide:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Bookmark persistence","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"SwiftData models","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Window management"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Search UI","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"App settings","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Onboarding","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A full browser-style navigation history","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It gives you the loading\/parsing\/rendering pieces. Your app decides how those pieces are presented and stored."}]}],"kind":"content"}],"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"DocCKit","modules":[{"name":"Template"}]},"references":{"doc://Template/documentation/Template":{"identifier":"doc:\/\/Template\/documentation\/Template","kind":"symbol","type":"topic","abstract":[],"title":"Template","url":"\/documentation\/template","role":"collection"},"https://github.com/Mcrich-LLC/DocB":{"identifier":"https:\/\/github.com\/Mcrich-LLC\/DocB","titleInlineContent":[{"text":"DocB","type":"text"}],"url":"https:\/\/github.com\/Mcrich-LLC\/DocB","type":"link","title":"DocB"}}}